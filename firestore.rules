rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a member of the family
    // Note: We use exists() but carefully to avoid circular triggers
    function isMember(familyId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // User profile: only the user themselves can read/write their profile
    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Families: 
    match /families/{familyId} {
      // Allow creation if the user is authenticated (first user becomes admin)
      allow create: if isAuthenticated();
      
      // Allow read for members (base family doc)
      allow read: if isMember(familyId);
      // Allow name updates for admins (or just members for now in Phase 1)
      allow update: if isMember(familyId);

      // Members subcollection - Critical to break circularity
      match /members/{memberId} {
        // Allow reading my own member doc to prove membership
        allow read: if isAuthenticated() && request.auth.uid == memberId;
        // Allow members to read other members
        allow read: if isMember(familyId);
        // Allow management
        allow write: if isMember(familyId);
      }

      // Other subcollections: Standard membership check
      match /tasks/{taskId} { 
        allow read, write: if isMember(familyId); 
      }
      match /events/{eventId} { 
        allow read, write: if isMember(familyId); 
      }
      match /requests/{requestId} { 
        allow read, write: if isMember(familyId); 
      }
      match /status/{statusId} { 
        allow read, write: if isMember(familyId); 
      }
    }
  }
}
