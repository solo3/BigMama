rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a member of the family
    function isMember(familyId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }
    
    // Helper to check if user is an admin of the family
    function isAdmin(familyId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // User profile: only the user themselves can read/write their profile
    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Families: 
    match /families/{familyId} {
      // Allow creation if the user is authenticated (logic usually handled by setting up subcollections)
      allow create: if isAuthenticated();
      
      // Allow read for members
      allow read: if isMember(familyId);
      
      // Allow updates only for members (e.g. changing name). 
      // Ideally restrict to admins, but keeping flexible for MVP.
      allow update: if isAdmin(familyId);

      // Members subcollection
      match /members/{memberId} {
        // Anyone in family can read members
        allow read: if isMember(familyId);
        
        // Creation (Joining): Currently flexible for invite flows
        allow create: if isAuthenticated();
        
        // Updates:
        // 1. Admin can update anyone
        // 2. User can update themselves (but NOT role)
        allow update: if isAdmin(familyId) || 
                     (request.auth.uid == memberId && 
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])));
        
        // Deletion: Only admins can remove members
        allow delete: if isAdmin(familyId);
      }

      // Feature Collections
      match /tasks/{taskId} { 
        allow read, write: if isMember(familyId); 
      }
      match /events/{eventId} { 
        allow read, write: if isMember(familyId); 
      }
      match /requests/{requestId} { 
        allow read, write: if isMember(familyId); 
      }
      match /status/{statusId} { 
        allow read, write: if isMember(familyId); 
      }
    }
  }
}
