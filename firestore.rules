rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a member of the family
    function isMember(familyId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }
    
    // Helper to check if user is an admin of the family
    function isAdmin(familyId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to get user's familyId from user doc
    function getUserFamilyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }

    // Audit collection: Top-level collection for logging all changes
    // Users can only read audit entries for their own family
    // No direct writes - only through service functions in the app
    match /audit/{auditId} {
      allow read: if isAuthenticated() && 
                   resource.data.familyId == getUserFamilyId();
      allow create, update, delete: if false;
    }

    // User profile: only the user themselves can read/write their profile
    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Invites: Root collection for easier querying by code
    match /invites/{inviteCode} {
      // Anyone can read an invite if they have the code (needed for joining)
      // Limitation: This allows enumerating invites if codes are guessable. 
      // Ideally, use a cloud function to validate code, or long random IDs.
      allow read: if true;

      // Only family admins can create invites for their family
      allow create: if isAdmin(request.resource.data.familyId);

      // Prevent delete
      allow delete: if false;
      
      // No updates allowed (immutable)
      allow update: if false;
    }

    // Families: 
    match /families/{familyId} {
      // Allow creation if the user is authenticated (logic usually handled by setting up subcollections)
      allow create: if isAuthenticated();
      
      // Allow read for members
      allow read: if isMember(familyId);
      
      // Allow updates only for members (e.g. changing name). 
      // Ideally restrict to admins, but keeping flexible for MVP.
      allow update: if isAdmin(familyId);

      // Prevent delete of family
      allow delete: if false;

      // Members subcollection
      match /members/{memberId} {
        // Anyone in family can read members
        allow read: if isMember(familyId);
        
        // Creation (Joining): Currently flexible for invite flows
        allow create: if isAuthenticated();
        
        // Updates:
        // 1. Admin can update anyone
        // 2. User can update themselves (but NOT role)
        allow update: if isAdmin(familyId) || 
                     (request.auth.uid == memberId && 
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])));
        
        // Deletion: Prevent member deletion (can only leave via update or role change)
        allow delete: if false;
      }

      // Feature Collections
      match /tasks/{taskId} { 
        allow read, write: if isMember(familyId); 
      }
      match /events/{eventId} { 
        allow read, write: if isMember(familyId); 
      }
      match /requests/{requestId} { 
        allow read, write: if isMember(familyId); 
      }
      match /status/{statusId} { 
        allow read, write: if isMember(familyId); 
      }
    }
  }
}
